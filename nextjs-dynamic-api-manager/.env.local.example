# 本地開發環境設定範例檔案
# 複製此檔案為 .env.local 並根據你的環境修改設定

# 應用程式環境
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# API 設定
NEXT_PUBLIC_API_URL=http://localhost:3000/api
BACKEND_API_URL=http://localhost:8080

# 應用程式設定
NEXT_PUBLIC_APP_NAME=Dynamic API Tech Manager (Local)
NEXT_PUBLIC_DEBUG_MODE=true

# 可選：如果後端在不同的主機或端口
# BACKEND_API_URL=http://192.168.1.50:8080